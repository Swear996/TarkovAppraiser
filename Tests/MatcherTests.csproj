<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Matcher tests: replays OCR readings of real tooltips (from debug logs) against the price list
    and checks that the right item comes out. Run with test.bat in the main folder.
    Compiles the app's own source files, so it always tests the current code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>TarkovPriceOverlay.Tests.TestRunner</StartupObject>
    <NoWarn>$(NoWarn);CS7022;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\*.cs" />
    <Compile Include="TestRunner.cs" />
    <Compile Include="NumberTests.cs" />
    <None Include="cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="digits.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
