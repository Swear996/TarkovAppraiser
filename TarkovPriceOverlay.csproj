<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- WFO1000: designer serialization hints for control properties - the controls are built in code, not in the designer -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TarkovAppraiser</AssemblyName>
    <Product>Tarkov Appraiser</Product>
    <AssemblyTitle>Tarkov Appraiser</AssemblyTitle>
    <ApplicationIcon>Assets\TarkovAppraiser.ico</ApplicationIcon>
    <Version>1.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- the matcher tests are a separate project (Tests\MatcherTests.csproj, run with test.bat) -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- official GitHub mark for the GitHub button (optional: without it a generic code icon is shown) -->
  <ItemGroup Condition="Exists('Assets\github-mark-white.png')">
    <EmbeddedResource Include="Assets\github-mark-white.png" LogicalName="github.png" />
  </ItemGroup>

</Project>
